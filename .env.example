# Copy to .env and set at least one provider. docs/configuration.md lists every setting.

# ── Server ──────────────────────────────────────────────────────────
PORT=3000
# Bearer token clients send to /v1/* and /mcp (default: leyline).
# LEYLINE_CLIENT_API_KEY=
# Publish a public URL through Janus (docs/remote-access.md).
LEYLINE_TUNNEL_ENABLED=false

# ── Cloud providers ─────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
HF_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
# AZURE_OPENAI_DEFAULT_MODEL=gpt-5.5

# ── Local models ────────────────────────────────────────────────────
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434

# ── Routing ─────────────────────────────────────────────────────────
# A small classifier model turns on semantic routing (docs/routing.md).
# LEYLINE_ROUTER_MODEL=arch-router-1.5b.gguf
# LEYLINE_OPENAI_BASE_URL=http://localhost:1234/v1
# LEYLINE_MODEL_2B=
# LEYLINE_MODEL_4B=
# LEYLINE_MODEL_12B=

# Send every request to one model instead:
# LEYLINE_ROUTER_ENABLED=false
# LEYLINE_FIXED_PROVIDER=OpenAI
# LEYLINE_FIXED_MODEL=gpt-5.5
